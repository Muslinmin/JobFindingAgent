# Copy this file to .env and fill in the values before running the app.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=

# ── Agent model ───────────────────────────────────────────────────────────────
# The model prefix tells LiteLLM which provider to route to:
#   Anthropic  →  MODEL=claude-sonnet-5
#   OpenAI     →  MODEL=gpt-4o-mini
#   Gemini     →  MODEL=gemini/gemini-2.0-flash-lite
MODEL=

# ── API key ───────────────────────────────────────────────────────────────────
# Paste the key for whichever provider you chose above. One key, any provider.
MODEL_API_KEY=

# ── Embedding model (scoring layer) ─────────────────────────────────────────────
# Routed through LiteLLM too, so the prefix convention is the same as MODEL above.
#   OpenAI  →  EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=

# Separate from MODEL_API_KEY because the embedding provider may differ from
# the chat provider above (e.g. chat on Gemini, embeddings on OpenAI).
# Get one at https://platform.openai.com/api-keys (requires billing set up).
EMBEDDING_API_KEY=

# Maximum results returned per  call
SCRAPE_MAX_RESULTS=

# ── Careers@Gov adapter (OGP open-data mirror) ──────────────────────────────
# Public, MIT-licensed data file — no credentials needed. Defaults live in
# app/config.py; only set these to override.
# CAREERS_GOV_DATA_URL=
# CAREERS_GOV_CACHE_TTL_S=

# ── Telegram bots (two: chat + notifications) ───────────────────────────────
# Get each bot token from @BotFather on Telegram — two separate bots.
TELEGRAM_CHAT_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_BOT_TOKEN=

# Your personal Telegram chat ID (both bots ignore all other senders).
# Send /start to @userinfobot to find your chat ID.
TELEGRAM_CHAT_ID=

# ── Internal API ──────────────────────────────────────────────────────────────
# Base URL the bot and scheduled jobs use to reach the FastAPI app.
API_BASE_URL=

# ── Cloud deployment notes ────────────────────────────────────────────────────
# On cloud platforms (Railway, Render, Fly.io, AWS etc.) do NOT upload this file.
# Instead, set each variable through the platform's environment/secrets dashboard:
#
#   Railway   → Project → Variables
#   Render    → Service → Environment
#   Fly.io    → fly secrets set MODEL_API_KEY=sk-...
#   AWS ECS   → Task Definition → Environment variables
#   Docker    → docker run -e MODEL_API_KEY=sk-... or use --env-file .env locally
